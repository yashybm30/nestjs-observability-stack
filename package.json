{
  "name": "nestjs-observability-stack",
  "version": "0.1.0",
  "private": true,
  "description": "nestjs observability stack",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch dist/main.js",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "format": "prettier --write src test",
    "test": "vitest run",
    "test:coverage": "vitest run --config vitest.coverage.config.mts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "pretest": "npm run build",
    "pretest:integration": "npm run build",
    "pretest:coverage": "npm run build"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "prom-client": "^15.1.3",
    "express": "^5.1.0",
    "zod": "^4.6.7",
    "@sentry/node": "^10.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/api": "^1.10.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "vitest": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.6.0"
  },
  "overrides": {
    "multer": "^2.4.1",
    "js-yaml": "^5.4.1"
  }
}
